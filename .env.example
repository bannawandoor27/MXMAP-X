# MXMAP-X Environment Configuration
# Copy this file to .env and fill in your values

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (async driver required for FastAPI)
DATABASE_URL=postgresql+asyncpg://mxmap_user:mxmap_password@localhost:5432/mxmap_db
DATABASE_ECHO=false

# ── API ───────────────────────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ── ML Models ─────────────────────────────────────────────────────────────────
MODEL_CONFIG_PATH=config/model_config.yaml
MODEL_CACHE_DIR=models/cache

# ── Ollama (for extraction pipeline) ──────────────────────────────────────────
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
